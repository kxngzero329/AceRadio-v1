{
  "name": "aceradio-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "branding:export": "node scripts/branding.cjs",
    "test:web-input": "node --test scripts/web-responder.test.cjs",
    "test:radio": "node --test scripts/radio.test.cjs",
    "test:navigation": "node --test scripts/navigation.test.cjs",
    "test:animations": "node --test scripts/animations.test.cjs scripts/spotlight.test.cjs",
    "test:startup": "node --test scripts/startup.test.cjs",
    "test:listening-ui": "node --test scripts/listening-ui.test.cjs",
    "test:safe-area": "node --test scripts/safe-area.test.cjs",
    "test:content": "node --test scripts/content.test.cjs",
    "test:events": "node --test scripts/events.test.cjs",
    "test:push": "node --test scripts/push.test.cjs scripts/push-batching.test.cjs scripts/push-client.test.cjs scripts/push-service.test.cjs scripts/push-config.test.cjs",
    "test:listeners": "node --test scripts/listeners.test.cjs",
    "test:accounts": "node --test scripts/accounts.test.cjs scripts/auth.test.cjs scripts/account-transfer.test.cjs",
    "backend:configure-auth": "node scripts/backend/configure-auth.cjs",
    "backend:configure": "node scripts/backend/configure.cjs",
    "backend:configure-eas": "node scripts/backend/configure-eas.cjs",
    "backend:types": "node scripts/backend/generate-types.cjs",
    "backend:seed": "node scripts/backend/seed.cjs",
    "backend:import": "node scripts/backend/import.cjs",
    "backend:verify": "node scripts/backend/verify.cjs",
    "backend:deploy-listeners": "node scripts/backend/deploy-listeners.cjs",
    "backend:deploy-push": "node scripts/backend/deploy-push.cjs",
    "backend:deploy-push-batching": "node scripts/backend/deploy-push-batching.cjs",
    "backend:setup-push": "node scripts/backend/setup-push.cjs",
    "backend:migrate": "npx --yes supabase db push --linked",
    "doctor": "expo-doctor",
    "build:android": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx --yes eas-cli@latest build --platform ios --profile preview",
    "test:media": "node --test scripts/media.test.cjs scripts/media-service.test.cjs",
    "media:prepare": "node scripts/backend/r2-media.cjs prepare",
    "media:upload": "node scripts/backend/r2-media.cjs upload",
    "backend:configure-r2": "node scripts/backend/configure-r2.cjs",
    "backend:deploy-media": "node scripts/backend/deploy-media.cjs",
    "media:cutover": "node scripts/backend/r2-media.cjs cutover",
    "backend:deploy-public-content": "node scripts/backend/deploy-public-content.cjs",
    "backend:setup-public-content": "node scripts/backend/setup-public-content.cjs",
    "test:public-content": "node --test scripts/public-content.test.cjs scripts/image-cache.test.cjs",
    "media:rollback": "node scripts/backend/r2-media.cjs rollback"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/query-async-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "57.0.5",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "1.18.0",
    "patch-package": "8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "~19.2.0",
    "aws4fetch": "1.0.20",
    "babel-preset-expo": "~57.0.15",
    "expo-dev-client": "~57.0.20",
    "expo-doctor": "^1.17.0",
    "image-size": "2.0.4",
    "react-native-svg-transformer": "~1.5.3",
    "sharp": "0.35.5",
    "typescript": "~6.0.3"
  }
}
