{
  "name": "aceradio-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:web-input": "node --test scripts/web-responder.test.cjs",
    "test:radio": "node --test scripts/radio.test.cjs",
    "test:navigation": "node --test scripts/navigation.test.cjs",
    "doctor": "expo-doctor",
    "build:android": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx --yes eas-cli@latest build --platform ios --profile preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "57.0.5",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "1.18.0",
    "patch-package": "8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.15",
    "expo-dev-client": "~57.0.20",
    "expo-doctor": "^1.17.0",
    "react-native-svg-transformer": "~1.5.3",
    "typescript": "~6.0.3"
  }
}
