# Safe default for a new checkout. The linked project's .env.local/EAS use supabase.
# Use supabase here only after configuring and verifying the target backend.
EXPO_PUBLIC_CONTENT_SOURCE=bundled
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Reserved for future SMTP setup tooling; email/password signup does not use this flag.
EXPO_PUBLIC_AUTH_EMAIL_CODES_READY=false

# Only publishable / legacy anon keys belong in EXPO_PUBLIC_* variables.
# Never add service-role keys, sb_secret_* keys, database passwords or CLI tokens here.
# `npm run backend:configure` reads the linked project and writes public settings to
# ignored .env.local while preserving the current source. The linked EAS project's
# environments are already configured. See docs/supabase.md for other setups.
# Live audio always uses src/config/station.ts and does not depend on Supabase.
